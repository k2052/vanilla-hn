{
  "name": "vanilla-hn",
  "version": "1.0.0",
  "description": "An HN client in vanilla JS. No frameworks",
  "type": "module",
  "repository": "https://github.com/k2052/vanilla-hn",
  "author": "K-2052",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/index.js --outDir dist/server",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "deploy.gh": "npm run build:client && node scripts/deploy.js"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "koa": "^3.2.1",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "lodash.get": "^4.4.2",
    "ms": "^2.1.3",
    "switch-path": "^1.2.0",
    "url-parse": "^1.5.10",
    "window-or-global": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "postcss-preset-env": "^11.6.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.7"
  }
}
